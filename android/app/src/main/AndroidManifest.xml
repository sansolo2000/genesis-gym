<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- E1: avisos. Ninguno de estos permisos da acceso a datos personales. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarmas a la hora exacta: Android 14+ lo deja APAGADO; Héctor lo activa a mano si quiere. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Para volver a programar los avisos al encender el celular. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- allowBackup=false: la copia automática de Android no se usa. Los datos (de salud, más adelante)
         salen del celular solo con el respaldo de la propia app, hacia el Drive de Héctor. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".AlarmaReceiver" android:exported="false" />

        <receiver android:name=".ArranqueReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
