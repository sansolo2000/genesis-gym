<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- E3: Drive (solo hacia googleapis.com). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- E1: avisos. Ninguno de estos permisos da acceso a datos personales. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarmas a la hora exacta: Android 14+ lo deja APAGADO; Héctor lo activa a mano si quiere. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Para volver a programar los avisos al encender el celular. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- M-10: la alerta suena hasta Detener o Posponer (servicio en primer plano, máximo 2 min) y vibra según cada tipo.
         Son permisos normales: Android los da al instalar, sin preguntar. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- E2: Health Connect, SOLO LECTURA y solo estos 4 tipos. Héctor elige cuáles concede. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <!-- E6: datos de las actividades para el Evaluador (distancia, desnivel y FC media de cada salida). -->
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- 0.19.0, entrega 2 de datos diarios (aprobado por Héctor, CONTEXTO-DATOS-DIARIOS R2): leer Health Connect en segundo plano. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- allowBackup=false: la copia automática de Android no se usa. Los datos (de salud, más adelante)
         salen del celular solo con el respaldo de la propia app, hacia el Drive de Héctor. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Política de privacidad que abre Health Connect (obligatoria). -->
        <activity
            android:name=".PrivacidadActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PrivacidadActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <receiver android:name=".AlarmaReceiver" android:exported="false" />
        <!-- E5: avisos reales (comidas, tareas, entrenamiento y reporte) -->
        <receiver android:name=".RecordatorioReceiver" android:exported="false" />
        <!-- M-10: alerta que suena hasta Detener o Posponer, y los botones de su notificación -->
        <service android:name=".AlertaServicio" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <receiver android:name=".AccionAlerta" android:exported="false" />
        <!-- Medicamentos: alarma de cada toma (se repite cada 10 min hasta 2 h) y los botones Confirmar y Omitir -->
        <receiver android:name=".MedicamentoReceiver" android:exported="false" />
        <receiver android:name=".AccionMedicamento" android:exported="false" />
        <!-- E5: carpeta temporal para la foto de la cámara -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/archivos" />
        </provider>

        <receiver android:name=".ArranqueReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <!-- Medicamentos: la hora local configurada se mantiene si cambia la zona horaria o la hora -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
